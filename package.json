{
  "name": "complain-finder",
  "version": "0.1.0",
  "description": "Detect Bill.com and QuickBooks complaints on Twitter/X, classify them, and send Telegram notifications",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js | pino-pretty",
    "test": "node --test test/*.test.js",
    "test:twitter": "node scripts/test-twitter.js",
    "test:openai": "node scripts/test-openai.js",
    "test:telegram": "node scripts/test-telegram.js",
    "dry-run": "node scripts/dry-run.js"
  },
  "type": "module",
  "license": "PRIVATE",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "context.dev": "^3.5.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "telegraf": "^4.16.3",
    "twitter-api-v2": "^1.29.0"
  },
  "devDependencies": {
    "puppeteer-core": "^24.42.0"
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true
  }
}
